    "type": "git",
    "url": "git+https://github.com/cccteam/ccc-lib.git",
    "directory": "projects/resource-angular"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
