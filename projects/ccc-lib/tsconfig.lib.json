/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "tsconfigRootDir": ".",
  "compilerOptions": {
    "paths": {
      "@cccteam/ccc-lib/*": ["projects/ccc-lib/*"],
      "@cccteam/ccc-lib": ["projects/ccc-lib/index.ts"],
      "@cccteam/resource": ["dist/resource"]
    },
    "sourceMap": true,
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "exclude": ["**/*.spec.ts"]
}
